{
  "name": "universal-knowledge-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first web annotation, knowledge graph and research workspace (Chrome MV3 extension + PWA).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ukw/pwa",
    "dev:extension": "npm run dev -w @ukw/extension",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @ukw/pwa && npm run build -w @ukw/extension",
    "build:pwa": "npm run build -w @ukw/pwa",
    "build:extension": "npm run build -w @ukw/extension",
    "verify": "npm run typecheck && npm run build && npm run verify:extension && npm run test",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:extension": "node scripts/verify-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
